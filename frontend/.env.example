# Israfil BD Shop - Frontend Environment Configuration

# Backend API URL (যেখানে ব্যাকএন্ড Laravel API রান হচ্ছে)
VITE_API_URL=http://127.0.0.1:8000/api

# Backend Server Root URL (ছবি ও স্টোরেজ লিংকের জন্য)
VITE_BACKEND_URL=http://127.0.0.1:8000

# Application Title
VITE_APP_NAME="ISRAFIL BD SHOP"

